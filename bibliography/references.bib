  pages={2169},
  year={2024},
  annote = {Conference study of aluminum-oxide aerosol released by reentering satellites, at roughly 10 Gg per year compared with about 0.4 Gg today and about 20 Gg from natural meteors. Uses a global climate model coupled to an aerosol model to see how particle size and reentry latitude affect stratospheric loading and radiative heating; the group's 2025 JGR paper follows up on this work.},
  category = {environment}
}


