}

@article{maloney2025investigating,
  title={Investigating the potential atmospheric accumulation and radiative impact of the coming increase in satellite reentry frequency},
  author={Maloney, Christopher M and Portmann, Robert W and Ross, Martin N and Rosenlof, Karen H},
  journal={Journal of Geophysical Research: Atmospheres},
  volume={130},
  number={6},
  pages={e2024JD042442},
  year={2025},
  publisher={Wiley Online Library},
  doi = {10.1029/2024JD042442},
  annote = {Climate-model study of aluminum-oxide aerosol from satellites vaporizing on reentry at 10 Gg per year, the rate projected for megaconstellation growth by about 2040. Some 20–40 Gg accumulates in the stratosphere poleward of 30°, producing temperature anomalies of about 1.5 K at high southern latitudes and a roughly 10\% weaker Southern Hemisphere polar vortex, with knock-on effects on the springtime ozone hole.},
  category = {environment}
}

@inproceedings{maloney2024stratospheric,
  title={Stratospheric loading and radiative impacts from increased Al2O3 emission caused by an anticipated increase in satellite re-entry frequency},
  author={Maloney, Christopher and Portmann, Robert and Rosenlof, Karen H and Bardeen, Charles},
