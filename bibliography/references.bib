  annote = {GAO review (November 2022) of how the FCC licenses large constellations. It found the FCC had not adequately documented its use of a categorical exclusion from environmental review under NEPA, had no schedule for revisiting it, and had not published what would trigger a fuller review. The FCC agreed with all three recommendations.},
  category = {environment}
}

@misc{fasArticle,
  author={Mehlman, Amy and Janka, John P. and Sturza, Mark A.},
