% Environmental impacts

@article{ferreira2024potential,
  title={Potential ozone depletion from satellite demise during atmospheric reentry in the era of mega-constellations},
  author={Ferreira, Jos{\'e} P and Huang, Ziyu and Nomura, Ken-ichi and Wang, Joseph},
  journal={Geophysical Research Letters},
  volume={51},
  number={11},
  pages={e2024GL109280},
  year={2024},
  publisher={Wiley Online Library},
  doi = {10.1029/2024GL109280},
  annote = {Molecular-dynamics simulations of how a satellite's aluminum oxidizes as it burns up on reentry. A typical 250 kg satellite yields about 30 kg of aluminum-oxide nanoparticles that can persist for decades and activate ozone-destroying chlorine; reentries in 2022 released about 17 t, and mega-constellation scenarios could exceed 360 t per year.},
  category = {environment}
}

@article{walker2020impact,
  title={Impact of satellite constellations on optical astronomy and recommendations toward mitigations},
  author={Walker, Constance and Hall, Jeffrey and Allen, Lori and Green, Richard and Seitzer, Patrick and Tyson, Tony and Bauer, Amanda and Krafton, Kelsie and Lowenthal, James and Parriott, Joel and others},
  journal={Bulletin of the American Astronomical Society},
  volume={52},
  number={2},
  year={2020},
  url = {https://baas.aas.org/pub/2020i0206},
  annote = {Report of the SATCON1 workshop (NSF NOIRLab and AAS, 2020). Finds that large LEO constellations will leave trails in astronomical images and change the night sky, and that no combination of mitigations fully avoids the impact if 100,000 or more satellites are launched. Recommends darker satellites, more accurate public orbit data, and software to mask trails and schedule observations around passes.},
  category = {environment}
}

@misc{gaoReport,
  title={Satellite Licensing: {FCC} Should Reexamine Its Environmental Review Process for Large Constellations of Satellites},
  howpublished={\url{https://www.gao.gov/products/gao-23-105005}},
